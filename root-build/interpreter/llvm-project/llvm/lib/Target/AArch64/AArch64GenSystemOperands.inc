#ifdef GET_TSBsList_IMPL
constexpr TSB TSBsList[] = {
  { "csync", 0x0,  {AArch64::FeatureTRACEV8_4}  }, // 0
 };

const TSB *lookupTSBByEncoding(uint8_t Encoding) {
  if ((uint8_t)Encoding != std::clamp((uint8_t)Encoding, (uint8_t)0x0, (uint8_t)0x0))
    return nullptr;

  auto Table = ArrayRef(TSBsList);
  size_t Idx = Encoding - 0x0;
  return &Table[Idx];
}

