bool AArch64GenRegisterInfo::
isGeneralPurposeRegister(const MachineFunction &MF, MCRegister PhysReg) const {
  return
      AArch64::GPR64RegClass.contains(PhysReg) ||
      AArch64::GPR32RegClass.contains(PhysReg) ||
      false;
}

bool AArch64GenRegisterInfo::
isGeneralPurposeRegisterClass(const TargetRegisterClass *RC) const {
  return
      AArch64::GPR64RegClass.hasSubClassEq(RC) ||
      AArch64::GPR32RegClass.hasSubClassEq(RC) ||
      false;
}

bool AArch64GenRegisterInfo::
isFixedRegister(const MachineFunction &MF, MCRegister PhysReg) const {
  return
      AArch64::CCRRegClass.contains(PhysReg) ||
      AArch64::FIXED_REGSRegClass.contains(PhysReg) ||
      false;
}

bool AArch64GenRegisterInfo::
isArgumentRegister(const MachineFunction &MF, MCRegister PhysReg) const {
  return
      false;
}

bool AArch64GenRegisterInfo::
isConstantPhysReg(MCRegister PhysReg) const {
  return
      PhysReg == AArch64::WZR ||
      PhysReg == AArch64::XZR ||
      false;
}

