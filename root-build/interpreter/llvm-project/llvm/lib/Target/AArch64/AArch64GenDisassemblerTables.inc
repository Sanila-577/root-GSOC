    return ((Bits[AArch64::FeatureAll] || Bits[AArch64::FeatureSME_TMOP]) && (Bits[AArch64::FeatureAll] || Bits[AArch64::FeatureSMEF8F32]));
  case 5:
    return ((Bits[AArch64::FeatureAll] || Bits[AArch64::FeatureSME_TMOP]) && (Bits[AArch64::FeatureAll] || Bits[AArch64::FeatureSMEF8F16]));
  case 6:
