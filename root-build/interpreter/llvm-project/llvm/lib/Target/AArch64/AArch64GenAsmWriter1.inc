    break;
  case 42:
    printTypedVectorList<0,'h'>(MI, OpIdx, STI, OS);
    break;
  case 43:
    printTypedVectorList<16, 'b'>(MI, OpIdx, STI, OS);
    break;
  case 44:
    printTypedVectorList<1, 'd'>(MI, OpIdx, STI, OS);
    break;
