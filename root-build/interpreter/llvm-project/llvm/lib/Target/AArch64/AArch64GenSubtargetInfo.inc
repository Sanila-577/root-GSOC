      return 1616; // WriteIEReg_ReadI_CortexA55ReadNotShifted
    }
    if (CPUID == 13) { // ExynosM3Model
      if (AArch64_MC::isExynosArithFast(*MI))
        return 1661; // M3WriteA1
      if (AArch64_MC::isExynosLogicFast(*MI))
        return 1661; // M3WriteA1
      return 1662; // M3WriteAA
    }
    if (CPUID == 14) { // ExynosM4Model
      if (AArch64_MC::isExynosArithFast(*MI))
        return 1663; // M4WriteA1
      if (AArch64_MC::isExynosLogicExFast(*MI))
        return 1663; // M4WriteA1
      return 1664; // M4WriteAA
    }
    if (CPUID == 15) { // ExynosM5Model
      if (AArch64_MC::isExynosArithFast(*MI))
        return 1703; // M5WriteA1W
      if (AArch64_MC::isExynosLogicExFast(*MI))
        return 1703; // M5WriteA1W
      return 1771; // M5WriteAAW
    }
    if (CPUID == 16) { // FalkorModel
      return 1660; // FalkorWr_2XYZ_2cyc
    }
    if (CPUID == 20) { // ThunderXT8XModel
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1617; // WriteIEReg_ReadI_THXT8XReadShifted
      return 1618; // WriteIEReg_ReadI_THXT8XReadNotShifted
    }
    if (CPUID == 23) { // TSV110Model
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1658; // WriteISReg
      return 1651; // WriteI
    }
    break;
  case 1434: // SUBXrx_SUBXrx64
    if (CPUID == 2) { // Ampere1Model
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1756; // Ampere1Write_2cyc_2AB
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 1757; // Ampere1Write_1cyc_1AB
      return 1758; // Ampere1Write_2cyc_1B_1AB
    }
    if (CPUID == 3) { // Ampere1BModel
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1672; // Ampere1BWrite_2cyc_2AB
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 1673; // Ampere1BWrite_1cyc_1AB
      return 1674; // Ampere1BWrite_2cyc_1B_1AB
    }
    if (CPUID == 5) { // CortexA53Model
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1613; // WriteIEReg_ReadI_A53ReadShifted
      return 1614; // WriteIEReg_ReadI_A53ReadNotShifted
    }
    if (CPUID == 7) { // CortexA55Model
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1615; // WriteIEReg_ReadI_CortexA55ReadShifted
      return 1616; // WriteIEReg_ReadI_CortexA55ReadNotShifted
    }
    if (CPUID == 13) { // ExynosM3Model
      if (AArch64_MC::isExynosArithFast(*MI))
        return 1661; // M3WriteA1
      if (AArch64_MC::isExynosLogicFast(*MI))
        return 1661; // M3WriteA1
      return 1662; // M3WriteAA
    }
    if (CPUID == 14) { // ExynosM4Model
      if (AArch64_MC::isExynosArithFast(*MI))
        return 1663; // M4WriteA1
      if (AArch64_MC::isExynosLogicExFast(*MI))
        return 1663; // M4WriteA1
      return 1664; // M4WriteAA
    }
    if (CPUID == 15) { // ExynosM5Model
      if (AArch64_MC::isExynosArithFast(*MI))
        return 1665; // M5WriteA1X
      if (AArch64_MC::isExynosLogicExFast(*MI))
        return 1665; // M5WriteA1X
      return 1666; // M5WriteAAX
    }
    if (CPUID == 16) { // FalkorModel
      return 1660; // FalkorWr_2XYZ_2cyc
    }
    if (CPUID == 20) { // ThunderXT8XModel
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1617; // WriteIEReg_ReadI_THXT8XReadShifted
      return 1618; // WriteIEReg_ReadI_THXT8XReadNotShifted
    }
    if (CPUID == 23) { // TSV110Model
      if (AArch64_MC::hasExtendedReg(*MI))
        return 1658; // WriteISReg
      return 1651; // WriteI
    }
    break;
  case 1582: // MOVIv2d_ns
    if (CPUID == 12) { // NeoverseV2Model
      if ((
            (
              (
                MI->getOpcode() == AArch64::MOVZWi
                || MI->getOpcode() == AArch64::MOVZXi
              )
              && MI->getOperand(1).isImm() 
              && MI->getOperand(1).getImm() == 0
              && MI->getOperand(2).getImm() == 0
            )
            || (
              (
                MI->getOpcode() == AArch64::ORRWrs
                || MI->getOpcode() == AArch64::ORRXrs
              )
              && (
                (
                  MI->getOperand(1).isReg() 
                  && (
                    MI->getOperand(1).getReg() == AArch64::WZR
                    || MI->getOperand(1).getReg() == AArch64::XZR
                  )
                )
                && MI->getOperand(3).getImm() == 0
              )
            )
            || (
              (
                MI->getOpcode() == AArch64::FMOVWHr
                || MI->getOpcode() == AArch64::FMOVXHr
                || MI->getOpcode() == AArch64::FMOVWSr
                || MI->getOpcode() == AArch64::FMOVXDr
              )
              && (
                MI->getOperand(1).isReg() 
                && (
                  MI->getOperand(1).getReg() == AArch64::WZR
                  || MI->getOperand(1).getReg() == AArch64::XZR
                )
              )
            )
            || (
              (
                MI->getOpcode() == AArch64::MOVID
                || MI->getOpcode() == AArch64::MOVIv2d_ns
              )
              && MI->getOperand(1).getImm() == 0
            )
          ))
        return 1752; // V2Write_0c
      return 1761; // V2Write_2c_1V
    }
    if (CPUID == 13) { // ExynosM3Model
      if (AArch64_MC::isZeroFPIdiom(*MI))
        return 1653; // M3WriteZ0
      return 1652; // M3WriteNALU1
    }
    if (CPUID == 14) { // ExynosM4Model
      if (AArch64_MC::isZeroFPIdiom(*MI))
        return 1655; // M4WriteZ0
      return 1654; // M4WriteNALU1
    }
    if (CPUID == 15) { // ExynosM5Model
      if (AArch64_MC::isZeroFPIdiom(*MI))
        return 1657; // M5WriteZ0
      return 1760; // M5WriteNALU1
    }
    break;
  };
  // Don't know how to resolve this scheduling class.
  return 0;
}
