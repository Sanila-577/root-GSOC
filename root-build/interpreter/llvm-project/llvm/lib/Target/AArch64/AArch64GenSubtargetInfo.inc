AArch64GenSubtargetInfo::AArch64GenSubtargetInfo(const Triple &TT, StringRef CPU, StringRef TuneCPU, StringRef FS)
  : TargetSubtargetInfo(TT, AArch64::resolveCPUAlias(CPU),
                        AArch64::resolveCPUAlias(TuneCPU), FS, ArrayRef(AArch64Names, 83), ArrayRef(AArch64FeatureKV, 309), ArrayRef(AArch64SubTypeKV, 72), 
                        AArch64WriteProcResTable, AArch64WriteLatencyTable, AArch64ReadAdvanceTable, 
                        nullptr, nullptr, nullptr) {}

unsigned AArch64GenSubtargetInfo
::resolveSchedClass(unsigned SchedClass, const MachineInstr *MI, const TargetSchedModel *SchedModel) const {

  const AArch64InstrInfo *TII =
    static_cast<const AArch64InstrInfo*>(SchedModel->getInstrInfo());
  (void)TII;

  switch (SchedClass) {
  case 16: // WriteISReg_ReadI_ReadISReg
    if (SchedModel->getProcessorID() == 5) { // CortexA53Model
      if (AArch64InstrInfo::hasShiftedReg(*MI))
        return 1597; // WriteISReg_ReadI_A53ReadShifted
      return 1598; // WriteISReg_ReadI_A53ReadNotShifted
    }
    if (SchedModel->getProcessorID() == 7) { // CortexA55Model
      if (AArch64InstrInfo::hasShiftedReg(*MI))
        return 1599; // WriteISReg_ReadI_CortexA55ReadShifted
      return 1600; // WriteISReg_ReadI_CortexA55ReadNotShifted
    }
    if (SchedModel->getProcessorID() == 9) { // NeoverseN2Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 1601; // N2Write_1c_1I_ReadI_ReadISReg
      return 1602; // N2Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 10) { // NeoverseN3Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 1603; // N3Write_1c_1I_ReadI_ReadISReg
      return 1604; // N3Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 11) { // NeoverseV1Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 1605; // V1Write_1c_1I_ReadI_ReadISReg
      return 1606; // V1Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 12) { // NeoverseV2Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 1607; // V2Write_1c_1I_ReadI_ReadISReg
      return 1608; // V2Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 18) { // NeoverseN1Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 1609; // N1Write_1c_1I_ReadI_ReadISReg
      return 1610; // N1Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 20) { // ThunderXT8XModel
      if (AArch64InstrInfo::hasShiftedReg(*MI))
        return 1611; // WriteISReg_ReadI_THXT8XReadShifted
      return 1612; // WriteISReg_ReadI_THXT8XReadNotShifted
    }
    break;
  case 17: // WriteIEReg_ReadI_ReadIEReg
    if (SchedModel->getProcessorID() == 5) { // CortexA53Model
      if (AArch64InstrInfo::hasExtendedReg(*MI))
        return 1613; // WriteIEReg_ReadI_A53ReadShifted
      return 1614; // WriteIEReg_ReadI_A53ReadNotShifted
    }
    if (SchedModel->getProcessorID() == 7) { // CortexA55Model
      if (AArch64InstrInfo::hasExtendedReg(*MI))
        return 1615; // WriteIEReg_ReadI_CortexA55ReadShifted
      return 1616; // WriteIEReg_ReadI_CortexA55ReadNotShifted
    }
    if (SchedModel->getProcessorID() == 20) { // ThunderXT8XModel
      if (AArch64InstrInfo::hasExtendedReg(*MI))
        return 1617; // WriteIEReg_ReadI_THXT8XReadShifted
      return 1618; // WriteIEReg_ReadI_THXT8XReadNotShifted
    }
    break;
  case 23: // WriteExtr_ReadExtrHi
    if (SchedModel->getProcessorID() == 11) { // NeoverseV1Model
      if ((
            (
              MI->getOpcode() == AArch64::EXTRWrri
              || MI->getOpcode() == AArch64::EXTRXrri
            )
            && MI->getOperand(1).getReg() == MI->getOperand(2).getReg()
          ))
        return 1619; // V1Write_1c_1I_ReadExtrHi
      return 1620; // V1Write_3c_1I_1M_ReadExtrHi
    }
    if (SchedModel->getProcessorID() == 12) { // NeoverseV2Model
      if ((
            (
              MI->getOpcode() == AArch64::EXTRWrri
              || MI->getOpcode() == AArch64::EXTRXrri
            )
            && MI->getOperand(1).getReg() == MI->getOperand(2).getReg()
          ))
        return 1621; // V2Write_1c_1I_ReadExtrHi
      return 1622; // V2Write_3c_1I_1M_ReadExtrHi
    }
    if (SchedModel->getProcessorID() == 13) { // ExynosM3Model
      if ((
            (
              MI->getOpcode() == AArch64::EXTRWrri
              || MI->getOpcode() == AArch64::EXTRXrri
            )
            && MI->getOperand(1).getReg() == MI->getOperand(2).getReg()
          ))
        return 1623; // M3WriteA1_ReadExtrHi
      return 1624; // M3WriteAA_ReadExtrHi
    }
    if (SchedModel->getProcessorID() == 14) { // ExynosM4Model
      if ((
            (
              MI->getOpcode() == AArch64::EXTRWrri
              || MI->getOpcode() == AArch64::EXTRXrri
            )
            && MI->getOperand(1).getReg() == MI->getOperand(2).getReg()
          ))
        return 1625; // M4WriteA1_ReadExtrHi
      return 1626; // M4WriteAF_ReadExtrHi
    }
    if (SchedModel->getProcessorID() == 15) { // ExynosM5Model
      if ((
            (
              MI->getOpcode() == AArch64::EXTRWrri
              || MI->getOpcode() == AArch64::EXTRXrri
            )
            && MI->getOperand(1).getReg() == MI->getOperand(2).getReg()
          ))
        return 1627; // M5WriteA1W_ReadExtrHi
      return 1628; // M5WriteAFW_ReadExtrHi
    }
    if (SchedModel->getProcessorID() == 18) { // NeoverseN1Model
      if ((
